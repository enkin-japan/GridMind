# GridMind 環境変数のサンプル。実際の値は .env にコピーして記入する（.env は git 管理外）。

# --- OpenAI（サービス側が用意する。利用者には見せない）---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# --- サーバ ---
# express-session の署名鍵
SESSION_SECRET=change-me-to-a-long-random-string
# ポート番号
PORT=3000
# 監視ホスト。既定 127.0.0.1（ループバックのみ）。全インターフェースに開くなら 0.0.0.0
HOST=127.0.0.1

# --- ファイル変換ワーカー（tools/md_worker.py）---
# 同時に動かすワーカー数。既定は「CPU コア数 - 1」を上限4本におさえる。
# MD_WORKERS=4
# 1件あたりの制限時間（ミリ秒）。これを超えたワーカーは作り直す。
# MD_TIMEOUT_MS=60000
# 待ち行列の上限。あふれた分は 503 を返す。
# MD_MAX_QUEUE=50

# --- AI 整理 ---
# この文字数以下なら分割せず1回で整理する
# AI_SINGLE_LIMIT=15000
# 分割するときの1断片の文字数
# AI_CHUNK_SIZE=12000
# 断片を同時に何本まで投げるか（レート制限に合わせて調整する）
# AI_CHUNK_CONCURRENCY=3
# 受けつける資料の最大文字数（プラン上限より優先される全体の上限）
# AI_MAX_DOC_CHARS=60000

# --- 料金プランの上限 ---
# PLAN_FREE_INGESTS=30
# PLAN_FREE_DOC_CHARS=20000
# PLAN_PRO_INGESTS=500
# PLAN_PRO_DOC_CHARS=60000

# --- アップロード一時ファイルの掃除 ---
# この時間より古い取り残しを削除する（ミリ秒）
# UPLOAD_MAX_AGE_MS=1800000
# 掃除の間隔（ミリ秒）
# UPLOAD_SWEEP_MS=600000

# --- リバースプロキシ / HTTPS 運用 ---
# nginx や tailscale serve の後ろで動かすときは 1 にする
# TRUST_PROXY=1
# HTTPS で公開するときは 1 にする（cookie に secure が付く）
# COOKIE_SECURE=1

# --- 意味ベクトル（二次整理の関連づけ）---
# 整理用と同じ OPENAI_API_KEY を使う。専用のキーは不要。
# EMBEDDING_MODEL=text-embedding-3-small
# ベクトルを使わずに動かすときは 0（語の重なりだけで関連づける）
# EMBEDDING_ENABLED=1
# 1件あたりに渡す文字数の上限
# EMBEDDING_MAX_CHARS=8000

# --- 仕上げに上位モデルを使う（任意）---
# 図の多い資料は文字の取り出しが崩れ、ラベルと数値が入れちがったまま
# もっともらしい文になることがある（例：国家予算が「8億4700万円」になる）。
# 4o-mini はこれを見抜けず、gpt-4o は落とせた。
#
# ただし費用は大きく変わる。この設定が効くのは次の2か所:
#   ・長い資料 → 最後の「まとめ直し」だけ（入力は抽出済みの知識点だけなので安い）
#   ・短い資料 → 1回で整理するため、資料まるごとが上位モデルに渡る（高い）
# 実測（1件あたり）: 4o-mini のみ 約 $0.002 ／ AI_FINAL_MODEL=gpt-4o 約 $0.015
# 未設定なら OPENAI_MODEL がすべての段階で使われる（既定＝安い方）。
# AI_FINAL_MODEL=gpt-4o

# --- アップロード ---
# 1ファイルの上限（MB）
# MAX_UPLOAD_MB=40

# --- gpt-5 系の調整つまみ（通常は未設定でよい）---
# temperature / top_p は使えず、代わりに次の2つで調整する。
# 実測では既定のままが最も精度がよく、上げると費用も時間も2〜3倍になったうえ
# 図表の崩れた資料での誤りがむしろ増えた。変える前に必ず自分の資料で確かめること。
#   none / low / medium / high / xhigh / max
# AI_REASONING_EFFORT=high
#   low / medium / high （low にすると出力は1割減るが、本文も短くなる）
# AI_VERBOSITY=low
