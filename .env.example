# GridMind 環境変数のサンプル。実際の値は .env にコピーして記入する（.env は git 管理外）。
#
# 起動時に config.js が中身を確かめる。
#   ・【必須】の項目が未記入   → 起動しない
#   ・値の書式が壊れている     → 起動しない（PORT=abc、AI_TWO_STAGE=true など）
#   ・任意の項目は未記入でよい → 既定値で動く。知らせたいことは警告で出す

# --- OpenAI（サービス側が用意する。利用者には見せない）---
# 未記入でも起動はするが、AI 整理と意味ベクトルは動かない（警告が出る）。
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-5.6-luna

# --- サーバ ---
# 【必須】express-session の署名鍵。長い乱数にする
SESSION_SECRET=change-me-to-a-long-random-string
# 【必須】ポート番号（1〜65535）
PORT=3000
# 【必須】監視ホスト。127.0.0.1 ならループバックのみ。全インターフェースに開くなら 0.0.0.0
HOST=127.0.0.1

# --- ファイル変換ワーカー（tools/md_worker.py）---
# 同時に動かすワーカー数。既定は「CPU コア数 - 1」を上限4本におさえる。
# MD_WORKERS=4
# 1件あたりの制限時間（ミリ秒）。これを超えたワーカーは作り直す。
# MD_TIMEOUT_MS=60000
# 待ち行列の上限。あふれた分は 503 を返す。
# MD_MAX_QUEUE=50

# --- AI 整理 ---
# この文字数以下なら分割せず1回で整理する
# AI_SINGLE_LIMIT=15000
# 分割するときの1断片の文字数
# AI_CHUNK_SIZE=12000
# 断片を同時に何本まで投げるか（レート制限に合わせて調整する）
# AI_CHUNK_CONCURRENCY=3
# 受けつける資料の最大文字数（プラン上限より優先される全体の上限）
# AI_MAX_DOC_CHARS=60000

# --- 料金プランの上限 ---
# PLAN_FREE_INGESTS=30
# PLAN_FREE_DOC_CHARS=20000
# PLAN_PRO_INGESTS=500
# PLAN_PRO_DOC_CHARS=60000

# --- アップロード一時ファイルの掃除 ---
# この時間より古い取り残しを削除する（ミリ秒）
# UPLOAD_MAX_AGE_MS=1800000
# 掃除の間隔（ミリ秒）
# UPLOAD_SWEEP_MS=600000

# --- リバースプロキシ / HTTPS 運用 ---
# nginx や tailscale serve の後ろで動かすときは 1 にする
# TRUST_PROXY=1
# HTTPS で公開するときは 1 にする（cookie に secure が付く）
# COOKIE_SECURE=1

# --- 意味ベクトル（再整理の関連づけ）---
# 整理用と同じ OPENAI_API_KEY を使う。専用のキーは不要。
# EMBEDDING_MODEL=text-embedding-3-small
# ベクトルを使わずに動かすときは 0（語の重なりだけで関連づける）
# EMBEDDING_ENABLED=1
# 1件あたりに渡す文字数の上限
# EMBEDDING_MAX_CHARS=8000

# --- 仕上げだけ別のモデルにする（任意・通常は未設定でよい）---
# 図の多い資料は文字の取り出しが崩れ、ラベルと数値が入れちがったまま
# もっともらしい文になることがある（例：国家予算が「8億4700万円」になる）。
#
# もともとこの設定は、既定が gpt-4o-mini だったころに「仕上げだけ gpt-4o に任せて
# その誤りを落とす」ために作った。その後、同じ資料で3モデルを測り直した結果:
#   4o-mini … 誤りを3回とも残した
#   gpt-4o  … 誤りは消せたが、正しい数値まで一緒に消した
#   luna    … 誤りだけを消し、正しい数値と順位は残した
#   1件あたりの費用（23,337字）: 4o-mini $0.0032 ／ luna $0.0076 ／ gpt-4o $0.0526
# 既定を gpt-5.6-luna にしたので、この目的で gpt-4o へ上げる理由は無くなった。
#
# それでも上位モデル（gpt-5.6-terra / sol）を試したい場合の差し替え口として残してある。
# 渡る量は経路で違うので、費用は素直に倍にはならない:
#   ・長い資料 → まとめ直しだけ（入力は抽出済みの知識項目なので安い）
#   ・短い資料 → 単発整理と二段構えの書き上げで、資料本文がまるごと渡る（高い）
# 未設定なら、すべての段階で OPENAI_MODEL がそのまま使われる。
# AI_FINAL_MODEL=gpt-5.6-terra

# --- アップロード ---
# 1ファイルの上限（MB）
# MAX_UPLOAD_MB=40

# --- gpt-5 系の調整つまみ（通常は未設定でよい）---
# 実測の結果、どれも既定のままが最良だった。変える前に必ず自分の資料で確かめること。
#
# 推論の深さ: none / low / medium / high / xhigh / max
#   上げる → 費用と時間が2〜3倍。図表の崩れた資料では誤りがむしろ増えた。
#   none  → 費用2割・時間3割減るが、抽出できる知識が2〜4割減る。
# AI_REASONING_EFFORT=none
#
# 出力の量: low / medium / high
#   low にすると出力トークンは1割減るが、本文も短くなる（取りこぼしが増える）。
# AI_VERBOSITY=low
#
# temperature は AI_REASONING_EFFORT=none のときだけ指定できる（それ以外は 400）。
# ただし temperature=0 に seed を足しても出力は毎回変わり、再現性は得られない。
# AI_TEMPERATURE=0.1

# --- 二段構えの取り出し（洗い出し → 書き出し）---
# 1回で「探す」と「書く」を同時にやらせると拾い漏れが出るため、
# 先に知識項目の一覧を作らせ、次にその一覧を目次として資料の記述で埋めさせる。
# 実測（15000字未満の資料6件）:
#   現行の1回方式 … 295行 / 80秒 / $0.0258
#   二段構え     … 514行 / 147秒 / $0.0449  （知識 +74%、費用 +74%、時間 +84%）
# 6件すべてで知識量が増え、内容も水増しではなく実際の記述だった。
# 効くのは分割しない資料（15000字以下）だけ。分割経路はすでに
# 「断片ごとの抽出 → まとめ直し」という二段の形なので、さらに挟むと
# 三重のふるいになって逆効果だった（476行→394行、費用+58%、時間+46%）。
# 取りこぼしを減らしたい場合に有効。待ち時間が倍近くなる点に注意。
AI_TWO_STAGE=1
