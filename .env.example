# GridMind 環境変数のサンプル。実際の値は .env にコピーして記入する（.env は git 管理外）。
# OpenAI の API キー（開発検証用フォールバック。本番は各ユーザーが設定画面で登録し DB に暗号化保存）
OPENAI_API_KEY=sk-your-openai-api-key
# AI 整理に使う既定モデル
OPENAI_MODEL=gpt-4o-mini
# ユーザーの API キーを DB に保存する際の暗号化鍵（AES-256-GCM）。必ず各環境で固有の値にする。
#   生成例: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ENCRYPTION_KEY=change-me-to-a-long-random-string
# express-session の署名鍵
SESSION_SECRET=change-me-too
# サーバのポート番号
PORT=3000
# 監視ホスト。既定 127.0.0.1（ループバックのみ／tailscale serve でリバースプロキシ）。
# 全インターフェースに開くなら 0.0.0.0
HOST=127.0.0.1
