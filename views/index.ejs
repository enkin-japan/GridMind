<%- include('partials/header') %>

<div class="page-head">
  <h1><%= q ? t('home.title.search', { q }) : (tag ? t('home.title.tag', { tag }) : t('home.title')) %></h1>
  <p>
    <span class="ctr"><span><%= total %></span><% if (t('home.unit')) { %><span class="unit"><%= t('home.unit') %></span><% } %></span>
    <% if (q || tag) { %>　<a href="/"><%= t('home.reset') %></a><% } %>
  </p>
</div>

<%# タグは畳んでおく。開いたままだと一覧の先頭を丸ごと占領してしまう。
    絞り込み中だけは、何で絞っているかが見えるように開けておく。 %>
<% if (allTags && allTags.length) { %>
  <details class="tags"<%= tag ? ' open' : '' %>>
    <summary>
      <span class="grow"><%= t('home.tags') %></span>
      <span><%= allTags.length %></span>
    </summary>
    <div class="tape-row">
      <% allTags.forEach(function (x) { %>
        <a class="tape<%= tag === x.name ? ' active' : '' %>" href="/?tag=<%= encodeURIComponent(x.name) %>"><%= x.name %> <span class="count"><%= x.count %></span></a>
      <% }) %>
    </div>
  </details>
<% } %>

<% if (rows.length === 0) { %>
  <div class="empty">
    <p><%= q || tag ? t('home.empty.filtered') : t('home.empty') %></p>
    <a class="btn primary" href="/notes/import"><svg class="ico"><use href="#i-import"/></svg><%= t('home.empty.cta') %></a>
  </div>
<% } else { %>
  <%# 一覧はカードの並びではなく1本のロール。送り穴は左端を途切れず走る。 %>
  <div class="roll">
    <div class="perf-col" aria-hidden="true"></div>
    <div class="roll-frames">
      <% rows.forEach(function (note) { %>
        <a class="frame" href="/notes/<%= note.id %>">
          <h2><%= note.title %></h2>
          <% if (note.summary) { %><p class="summary"><%= note.summary %></p><% } %>
          <% if (note.tags && note.tags.length) { %>
            <div class="frame-tapes">
              <% note.tags.forEach(function (x) { %><span class="tape sm"><%= x %></span><% }) %>
            </div>
          <% } %>
          <div class="edge-code">
            <b>GM<%= String(note.id).padStart(4, '0') %></b>
            <%= note.created_at.slice(0, 10) %>
          </div>
        </a>
      <% }) %>
    </div>
  </div>

  <% if (pages > 1) { %>
    <nav class="pager" aria-label="<%= t('home.pager') %>">
      <% for (let p = 1; p <= pages; p++) { %>
        <a class="page<%= p === page ? ' active' : '' %>"
           <%= p === page ? 'aria-current="page"' : '' %>
           href="/?<%= q ? 'q=' + encodeURIComponent(q) + '&' : '' %><%= tag ? 'tag=' + encodeURIComponent(tag) + '&' : '' %>page=<%= p %>"><%= p %></a>
      <% } %>
    </nav>
  <% } %>
<% } %>

<%- include('partials/footer') %>
