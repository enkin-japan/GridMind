<%- include('../partials/header') %>

<div class="auth-card">
  <h1>ログイン</h1>
  <% if (errors && errors.length) { %>
    <ul class="errors"><% errors.forEach(function (e) { %><li><%= e.msg %></li><% }) %></ul>
  <% } %>
  <form action="/login" method="post" class="note-form">
    <label>ユーザー名
      <input type="text" name="username" value="<%= values.username || '' %>" required autofocus>
    </label>
    <label>パスワード
      <input type="password" name="password" required>
    </label>
    <div class="form-actions">
      <button class="btn primary" type="submit">ログイン</button>
    </div>
  </form>
  <p class="muted">アカウントがない場合は <a href="/register">新規登録</a></p>
</div>

<%- include('../partials/footer') %>
