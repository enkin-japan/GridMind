<%- include('../partials/header') %>

<form action="/notes/reconcile/merge/commit" method="post" class="note-form">
  <h1>統合プレビュー</h1>
  <p class="muted">
    既存ノート「<strong><%= old.title %></strong>」に統合します。内容を確認・編集して保存してください。
    （元のノートが更新され、被リンクは保持されます。新しいノートは作られません）
  </p>

  <label>タイトル <span class="req">*</span>
    <input type="text" name="title" value="<%= merged.title %>" required>
  </label>
  <label>タグ（カンマ区切り）
    <input type="text" name="tags" value="<%= (merged.tags || []).join(', ') %>">
  </label>
  <label>要約
    <input type="text" name="summary" value="<%= merged.summary || '' %>">
  </label>
  <label>本文（Markdown）
    <textarea name="body_md" rows="20"><%= merged.markdown %></textarea>
  </label>

  <div class="form-actions">
    <button class="btn primary" type="submit">統合して保存</button>
    <a class="btn" href="/notes/reconcile">戻る</a>
  </div>
</form>

<%- include('../partials/footer') %>
