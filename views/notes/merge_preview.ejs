<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= t('merge.title') %></h1>
  <p><%- t('merge.lede', { title: '<strong>' + old.title + '</strong>' }) %></p>
</div>

<form action="/notes/reconcile/merge/commit" method="post" class="sheet form-narrow">
  <label class="field">
    <span class="cap"><%= t('form.title') %> <span class="req">*</span></span>
    <input type="text" name="title" value="<%= merged.title %>" required>
  </label>
  <label class="field">
    <span class="cap"><%= t('form.tags') %></span>
    <input type="text" name="tags" value="<%= (merged.tags || []).join(', ') %>">
    <small class="hint"><%= t('form.tags.hint') %></small>
  </label>
  <label class="field">
    <span class="cap"><%= t('note.summary') %></span>
    <input type="text" name="summary" value="<%= merged.summary || '' %>">
  </label>
  <label class="field">
    <span class="cap"><%= t('form.body') %></span>
    <textarea name="body_md" rows="20"><%= merged.markdown %></textarea>
  </label>

  <div class="form-actions">
    <button class="btn primary" type="submit"><svg class="ico"><use href="#i-merge"/></svg><%= t('merge.submit') %></button>
    <a class="btn" href="/notes/reconcile"><svg class="ico"><use href="#i-back"/></svg><%= t('merge.back') %></a>
  </div>
</form>

<%- include('../partials/footer') %>
