<%- include('../partials/header') %>

<form id="import-form" class="note-form">
  <h1>ドキュメントを取り込む</h1>
  <p class="muted">
    ファイル（PDF / docx / pptx / xlsx / html / txt）か、貼り付けたテキストを AI が整理してノート化します。
  </p>

  <p class="muted small">
    今月の取り込み：<strong><%= usage.ingests %> / <%= plan.monthlyIngests %> 回</strong>
    （<%= plan.label %>プラン・1ファイル <%= plan.maxDocChars.toLocaleString() %> 文字まで）
    　<a href="/settings">設定</a>
  </p>

  <label>ファイルを選択（複数選べます）
    <input type="file" id="import-file" name="file" multiple
           accept=".pdf,.docx,.pptx,.xlsx,.html,.htm,.txt,.md,.csv">
    <small class="muted">複数選んだときは、1ファイルずつ順番に処理します（AI が集中して整理できるように）。</small>
  </label>

  <p class="muted" style="text-align:center;">— または —</p>

  <label>テキストを貼り付け
    <textarea id="import-text" name="text" rows="10" placeholder="ここにテキストを貼り付け…"></textarea>
  </label>

  <label>知識の出力言語
    <select id="import-lang" name="lang">
      <% Object.keys(languages).forEach(function (k) { %>
        <option value="<%= k %>" <%= k === defaultLang ? 'selected' : '' %>><%= languages[k].label %></option>
      <% }); %>
    </select>
    <small class="muted">
      英語の資料を日本語のノートにする、といった使い方ができます。「原文のまま」なら翻訳しません。
    </small>
  </label>

  <div class="form-actions">
    <button class="btn primary" type="submit" id="import-submit">AI で整理して取り込む</button>
    <a class="btn" href="/">キャンセル</a>
  </div>
  <p id="import-status" class="muted" role="status" aria-live="polite"></p>
</form>

<%- include('../partials/footer') %>
