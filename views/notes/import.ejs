<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= t('import.title') %></h1>
  <p><%= t('import.lede') %></p>
</div>

<form id="import-form" class="sheet form-narrow">
  <div class="quota-label">
    <span class="lbl"><%= t('import.quota') %></span>
    <span>
      <span class="ctr">
        <span><%= usage.ingests %></span><span class="sep">/</span><span><%= plan.monthlyIngests %></span><% if (t('set.unit.short')) { %><span class="unit"><%= t('set.unit.short') %></span><% } %>
      </span>
      　<a href="/settings"><%= t(plan.labelKey) %></a>
    </span>
  </div>

  <label class="field">
    <span class="cap"><%= t('import.file') %></span>
    <span class="drop">
      <input type="file" id="import-file" name="file" multiple
             accept=".pdf,.docx,.pptx,.pptm,.xlsx,.xlsm,.html,.htm,.txt,.md,.csv"
             data-nofile="<%= t('import.nofile') %>" data-nfiles="<%= t('import.nfiles') %>">
      <span class="btn primary" aria-hidden="true"><%= t('import.choose') %></span>
      <span class="drop-name" id="import-file-name"><%= t('import.nofile') %></span>
    </span>
    <small class="hint"><%= t('import.file.hint', { n: plan.maxDocChars.toLocaleString() }) %></small>
  </label>

  <label class="field">
    <span class="cap"><%= t('import.text') %></span>
    <textarea id="import-text" name="text" rows="8" placeholder="<%= t('import.text.placeholder') %>"></textarea>
  </label>

  <label class="field">
    <span class="cap"><%= t('import.lang') %></span>
    <select id="import-lang" name="lang">
      <% Object.keys(languages).forEach(function (k) { %>
        <option value="<%= k %>" <%= k === defaultLang ? 'selected' : '' %>><%= k === 'auto' ? t('outlang.auto') : languages[k].label %></option>
      <% }); %>
    </select>
    <small class="hint"><%= t('import.lang.hint') %></small>
  </label>

  <div class="form-actions">
    <button class="btn primary" type="submit" id="import-submit">
      <svg class="ico"><use href="#i-import"/></svg><%= t('import.submit') %>
    </button>
    <a class="btn" href="/"><svg class="ico"><use href="#i-back"/></svg><%= t('form.cancel') %></a>
  </div>
  <p id="import-status" class="notice" role="status" aria-live="polite"></p>

  <%# ゲート。20-35 秒かかる転写を、数える・吊るす・書き出すの3つで見せる。
      段階の切りかわりが来るまでは見積もりで進め、来たらそこへ合わせ直す
      （進捗は決して戻さない）。 %>
  <section id="ingest" class="gate" hidden aria-live="polite">
    <div class="gate-head">
      <span class="gate-stage" id="ingest-stage"><%= t('stage.ready') %></span>
      <span class="ctr"><span id="ingest-meta">0</span><span class="unit">%</span></span>
    </div>
    <div class="advance" role="progressbar" aria-labelledby="ingest-stage"
         aria-valuemin="0" aria-valuemax="100" aria-valuenow="0" id="ingest-bar">
      <i id="ingest-fill"></i><b id="ingest-gate"></b>
    </div>
    <div class="gate-body">
      <details class="bin" id="ingest-inv" hidden>
        <summary>
          <span class="grow"><%= t('import.bin') %></span>
          <span id="ingest-inv-n"></span>
        </summary>
        <ul class="bin-list" id="ingest-inv-list"></ul>
      </details>
      <div id="ingest-preview" class="gate-out" hidden></div>
    </div>
  </section>
</form>

<%- include('../partials/footer') %>
