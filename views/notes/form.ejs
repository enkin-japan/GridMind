<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= mode === 'edit' ? 'ノートを編集' : '新規ノート' %></h1>
</div>

<form class="sheet form-narrow" action="<%= mode === 'edit' ? '/notes/' + note.id + '/edit' : '/notes/new' %>" method="post">
  <% if (errors && errors.length) { %>
    <ul class="errors">
      <% errors.forEach(function (e) { %><li><%= e.msg %></li><% }) %>
    </ul>
  <% } %>

  <label class="field">
    <span class="cap">タイトル <span class="req">*</span></span>
    <input type="text" name="title" value="<%= note ? (note.title || '') : '' %>" required>
  </label>

  <label class="field">
    <span class="cap">タグ</span>
    <input type="text" name="tags" value="<%= note ? (note.tags_str || '') : '' %>" placeholder="例: 機械学習, メモ">
    <small class="hint">カンマ区切りで複数つけられます。</small>
  </label>

  <label class="field">
    <span class="cap">本文</span>
    <textarea name="body_md" rows="18"><%= note ? (note.body_md || '') : '' %></textarea>
    <small class="hint">Markdown で書けます。<code>[[別のノート名]]</code> と書くと、そのノートへの継ぎ目になります。</small>
  </label>

  <div class="form-actions">
    <button class="btn primary" type="submit">
      <svg class="ico"><use href="#i-check"/></svg><%= mode === 'edit' ? '更新' : '作成' %>
    </button>
    <a class="btn" href="<%= mode === 'edit' ? '/notes/' + note.id : '/' %>">
      <svg class="ico"><use href="#i-back"/></svg>キャンセル
    </a>
  </div>
</form>

<%- include('../partials/footer') %>
