<%- include('../partials/header') %>

<form class="note-form" action="<%= mode === 'edit' ? '/notes/' + note.id + '/edit' : '/notes/new' %>" method="post">
  <h1><%= mode === 'edit' ? 'ノートを編集' : '新規ノート' %></h1>

  <% if (errors && errors.length) { %>
    <ul class="errors">
      <% errors.forEach(function (e) { %><li><%= e.msg %></li><% }) %>
    </ul>
  <% } %>

  <label><span>タイトル <span class="req">*</span></span>
    <input type="text" name="title" value="<%= note ? (note.title || '') : '' %>" required>
  </label>

  <label>タグ（カンマ区切り）
    <input type="text" name="tags" value="<%= note ? (note.tags_str || '') : '' %>" placeholder="例: 機械学習, メモ">
  </label>

  <label><span>本文（Markdown・<code>[[別のノート名]]</code> でリンク）</span>
    <textarea name="body_md" rows="16"><%= note ? (note.body_md || '') : '' %></textarea>
  </label>

  <div class="form-actions">
    <button class="btn primary" type="submit"><%= mode === 'edit' ? '更新' : '作成' %></button>
    <a class="btn" href="<%= mode === 'edit' ? '/notes/' + note.id : '/' %>">キャンセル</a>
  </div>
</form>

<%- include('../partials/footer') %>
