<%- include('../partials/header') %>

<div class="page-head">
  <h1><%= t('rec.title') %></h1>
  <p><%- t('rec.lede', { title: '<strong>' + old.title + '</strong>' }) %></p>
</div>

<div class="compare">
  <section class="pane pane-new">
    <div class="pane-head">
      <span class="roll-id">A</span>
      <span class="lbl"><%= t('rec.new') %></span>
    </div>
    <div class="pane-body">
      <h3><%= staged.title %></h3>
      <div class="markdown-body"><%- newHtml %></div>
    </div>
  </section>
  <section class="pane pane-old">
    <div class="pane-head">
      <span class="roll-id">B</span>
      <span class="lbl"><%= t('rec.old') %></span>
    </div>
    <div class="pane-body">
      <h3><%= old.title %></h3>
      <div class="markdown-body"><%- oldHtml %></div>
    </div>
  </section>
</div>

<div class="sheet decide">
  <form action="/notes/reconcile/link" method="post">
    <button class="btn primary" type="submit"><svg class="ico"><use href="#i-splice"/></svg><%= t('rec.link') %></button>
    <span class="hint"><%= t('rec.link.hint') %></span>
  </form>
  <form action="/notes/reconcile/merge" method="post">
    <button class="btn" type="submit"><svg class="ico"><use href="#i-merge"/></svg><%= t('rec.merge') %></button>
    <span class="hint"><%= t('rec.merge.hint') %></span>
  </form>
  <form action="/notes/reconcile/plain" method="post">
    <button class="btn ghost" type="submit"><%= t('rec.plain') %></button>
    <span class="hint"><%= t('rec.plain.hint') %></span>
  </form>
</div>

<%- include('../partials/footer') %>
