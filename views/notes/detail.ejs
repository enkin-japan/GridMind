<%- include('../partials/header') %>

<%
  // 削った量。元の文字数を控えていないノート（この機能より前のもの）では出さない。
  // 分からないものを、分かったふりに埋めない。
  const kept = (note.body_md || '').length;
  const src = note.src_chars;
  const cut = src && src > kept ? Math.round((1 - kept / src) * 100) : null;
%>

<article class="note-layout">
  <%# ライトボックス。このページで光るのはここだけ。 %>
  <div class="lightbox">
    <div class="note-bar">
      <h1 class="note-title"><%= note.title %></h1>
      <div class="acts">
        <a class="btn" href="/notes/<%= note.id %>/edit"><svg class="ico"><use href="#i-pencil"/></svg><%= t('note.edit') %></a>
        <form action="/notes/<%= note.id %>/delete" method="post" onsubmit="return confirm('<%= t('note.delete.confirm') %>');">
          <button class="btn danger" type="submit"><svg class="ico"><use href="#i-bin"/></svg><%= t('note.delete') %></button>
        </form>
      </div>
    </div>

    <% if (note.tags && note.tags.length) { %>
      <div class="tape-row">
        <% note.tags.forEach(function (x) { %><a class="tape" href="/?tag=<%= encodeURIComponent(x) %>"><%= x %></a><% }) %>
      </div>
    <% } %>

    <% if (note.summary) { %>
      <div class="summary-box">
        <span class="lbl"><%= t('note.summary') %></span>
        <%= note.summary %>
      </div>
    <% } %>

    <% if (html && html.trim()) { %>
      <div class="markdown-body"><%- html %></div>
    <% } else { %>
      <div class="markdown-body empty-body"><%= t('note.empty') %></div>
    <% } %>
  </div>

  <%# 欄外＝フィルムの縁。素性と行き先だけが住む。 %>
  <aside class="margin-col">
    <div class="margin-block">
      <span class="lbl"><%= t('note.about') %></span>
      <dl>
        <dt><%= t('note.code') %></dt>
        <dd>GM<%= String(note.id).padStart(4, '0') %></dd>
        <dt><%= t('note.source') %></dt>
        <dd><%= t(note.source_type === 'upload' ? 'note.source.upload' : 'note.source.paste') %></dd>
        <% if (cut !== null) { %>
          <dt><%= t('note.cut') %></dt>
          <dd>
            <span class="ctr"><span><%= cut %></span><span class="unit">%</span></span>
            <div style="margin-top:6px"><%= t('note.cut.chars', { src: src.toLocaleString(), kept: kept.toLocaleString() }) %></div>
          </dd>
        <% } %>
        <dt><%= t('note.created') %></dt>
        <dd><%= note.created_at.slice(0, 10) %></dd>
        <dt><%= t('note.updated') %></dt>
        <dd><%= note.updated_at.slice(0, 10) %></dd>
      </dl>
    </div>

    <div class="margin-block">
      <span class="lbl"><%= t('note.splices', { n: backlinks.length }) %></span>
      <% if (backlinks.length === 0) { %>
        <p class="none"><%= t('note.splices.none') %></p>
      <% } else { %>
        <ul>
          <% backlinks.forEach(function (b) { %>
            <li class="splice"><a href="/notes/<%= b.id %>"><%= b.title %></a></li>
          <% }) %>
        </ul>
      <% } %>
    </div>
  </aside>
</article>

<%- include('../partials/footer') %>
