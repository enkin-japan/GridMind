<%- include('partials/header') %>

<div class="page-head">
  <h1><%= t('set.title') %></h1>
</div>

<div class="form-narrow">
  <% if (saved === 'lang') { %>
    <p class="notice ok"><svg class="ico"><use href="#i-check"/></svg><%= t('set.saved.lang') %></p>
  <% } %>
  <% if (saved === 'plan') { %>
    <p class="notice ok"><svg class="ico"><use href="#i-check"/></svg><%= t('set.saved.plan') %></p>
  <% } %>
  <% if (saved === 'display') { %>
    <p class="notice ok"><svg class="ico"><use href="#i-check"/></svg><%= t('set.saved.display') %></p>
  <% } %>
  <% if (saved === 'pro_pending') { %>
    <p class="notice warn"><svg class="ico"><use href="#i-alert"/></svg><%= t('set.pro_pending') %></p>
  <% } %>

  <%# 画面の言語と表示テーマ。ノートの言語とは別ものなので、先にここで切り分ける。 %>
  <form action="/settings/display" method="post" class="sheet">
    <h2><%= t('set.display.h') %></h2>
    <p><%= t('set.display.body') %></p>

    <label class="field">
      <span class="cap"><%= t('set.uilang') %></span>
      <select name="ui_lang">
        <option value="" <%= uiLang ? '' : 'selected' %>><%= t('set.theme.auto') %></option>
        <% uiLangs.forEach(function (l) { %>
          <option value="<%= l.code %>" <%= l.code === uiLang ? 'selected' : '' %>><%= l.label %></option>
        <% }); %>
      </select>
    </label>

    <div class="field-row">
      <label class="field">
        <span class="cap"><%= t('set.theme') %></span>
        <select name="theme">
          <% ['auto', 'light', 'dark'].forEach(function (k) { %>
            <option value="<%= k %>" <%= k === theme ? 'selected' : '' %>><%= t('set.theme.' + k) %></option>
          <% }); %>
        </select>
      </label>

      <label class="field">
        <span class="cap"><%= t('set.stock') %></span>
        <select name="stock">
          <% lookKinds.stock.values.forEach(function (k) { %>
            <option value="<%= k %>" <%= k === look.stock ? 'selected' : '' %>><%= t('set.stock.' + k) %></option>
          <% }); %>
        </select>
      </label>

      <label class="field">
        <span class="cap"><%= t('set.density') %></span>
        <select name="density">
          <% lookKinds.density.values.forEach(function (k) { %>
            <option value="<%= k %>" <%= k === look.density ? 'selected' : '' %>><%= t('set.density.' + k) %></option>
          <% }); %>
        </select>
      </label>

      <label class="field">
        <span class="cap"><%= t('set.perf') %></span>
        <select name="perf">
          <% lookKinds.perf.values.forEach(function (k) { %>
            <option value="<%= k %>" <%= k === look.perf ? 'selected' : '' %>><%= t('set.perf.' + k) %></option>
          <% }); %>
        </select>
      </label>
    </div>

    <div class="form-actions">
      <button class="btn primary" type="submit"><svg class="ico"><use href="#i-check"/></svg><%= t('set.save') %></button>
    </div>
  </form>

  <%# プランと今月の使用量 %>
  <section class="sheet">
    <h2><%= t('set.plan.h') %></h2>
    <p><%- t('set.plan.current', {
        plan: '<strong>' + t(plan.labelKey) + '</strong>',
        price: t(plan.priceKey),
        period: usage.period,
      }) %></p>

    <%
      const used = usage.ingests;
      const cap  = plan.monthlyIngests;
      const pct  = Math.min(100, Math.round((used / cap) * 100));
      const hot  = pct >= 80;
    %>
    <div class="quota">
      <div class="quota-label">
        <span class="lbl"><%= t('set.quota.ingests') %></span>
        <span class="ctr<%= hot ? ' hot' : '' %>">
          <span><%= used %></span><span class="sep">/</span><span><%= cap %></span><% if (t('set.unit.short')) { %><span class="unit"><%= t('set.unit.short') %></span><% } %>
        </span>
      </div>
      <div class="quota-bar">
        <div class="quota-fill<%= hot ? ' hot' : '' %>" style="width: <%= pct %>%"></div>
      </div>
    </div>

    <div class="quota">
      <div class="quota-label">
        <span class="lbl"><%= t('set.quota.chars') %></span>
        <span class="ctr"><span><%= usage.chars.toLocaleString() %></span><span class="unit"><%= t('set.unit.chars') %></span></span>
      </div>
    </div>

    <table class="spec-table">
      <thead>
        <tr><th><%= t('set.th.plan') %></th><th><%= t('set.th.monthly') %></th><th><%= t('set.th.perfile') %></th><th></th></tr>
      </thead>
      <tbody>
        <% Object.values(plans).forEach(function (p) { %>
          <tr class="<%= p.key === plan.key ? 'current' : '' %>">
            <td><%= t(p.labelKey) %><% if (p.key === plan.key) { %><span class="badge"><%= t('set.badge.current') %></span><% } %></td>
            <td><%= p.monthlyIngests %> <%= t('set.unit.times') %></td>
            <td><%= p.maxDocChars.toLocaleString() %> <%= t('set.unit.chars') %></td>
            <td>
              <% if (p.key !== plan.key) { %>
                <form action="/settings/plan" method="post">
                  <input type="hidden" name="plan" value="<%= p.key %>">
                  <button class="btn" type="submit"><%= t(p.key === 'pro' ? 'set.apply' : 'set.revert') %></button>
                </form>
              <% } %>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </section>

  <%# ノートを何語で書くか（画面の言語とは別）%>
  <form action="/settings/language" method="post" class="sheet">
    <h2><%= t('set.outlang.h') %></h2>
    <p><%= t('set.outlang.body') %></p>
    <label class="field">
      <span class="cap"><%= t('set.outlang.default') %></span>
      <select name="out_lang">
        <% Object.keys(languages).forEach(function (k) { %>
          <option value="<%= k %>" <%= k === outLang ? 'selected' : '' %>><%= k === 'auto' ? t('outlang.auto') : languages[k].label %></option>
        <% }); %>
      </select>
    </label>
    <div class="form-actions">
      <button class="btn primary" type="submit"><svg class="ico"><use href="#i-check"/></svg><%= t('set.save') %></button>
    </div>
  </form>
</div>

<%- include('partials/footer') %>
